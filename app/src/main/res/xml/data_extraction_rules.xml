<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup="false" does not cover device transfer on API 31+; an absent section is open. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <!-- Device-protected storage. Nothing writes there today; an absent domain is permissive,
             not restrictive, so the first thing that does would be silently opted in. -->
        <exclude domain="device_root" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
        <exclude domain="device_file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <!-- Device-protected storage. Nothing writes there today; an absent domain is permissive,
             not restrictive, so the first thing that does would be silently opted in. -->
        <exclude domain="device_root" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
        <exclude domain="device_file" path="." />
    </device-transfer>
</data-extraction-rules>
