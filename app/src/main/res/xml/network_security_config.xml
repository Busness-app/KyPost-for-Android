<?xml version="1.0" encoding="utf-8"?>
<!-- Explicit, not the targetSdk default: any dependency's manifest can flip that app-wide. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
