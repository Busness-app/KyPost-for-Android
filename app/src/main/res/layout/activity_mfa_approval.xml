<?xml version="1.0" encoding="utf-8"?>
<!-- fitsSystemWindows because this screen applies no insets of its own: under edge-to-edge the
     approve/deny buttons would otherwise sit under the navigation bar, and a partly obscured Deny
     is not an acceptable state for an authentication prompt. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/mfaApprovalRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/mfaApprovalTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mfa_approval_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/mfaApprovalBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mfa_approval_body"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- The sign-in's origin. Without this the user is asked to approve nothing in
             particular, which is the whole mechanism an MFA-fatigue attack relies on. -->
        <TextView
            android:id="@+id/mfaApprovalContext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />

        <!-- Number matching is the ONLY way to approve. The server always mints the value it
             displays in the browser plus two decoys; a challenge that does not carry all three
             can be denied but never approved, so there is no bare Approve button to fall back
             to. See MfaNumberMatch. -->
        <LinearLayout
            android:id="@+id/mfaMatchGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/mfaMatchPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mfa_match_prompt"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/mfaMatchChoices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/mfaMatchUnavailable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mfa_match_unavailable"
            android:textSize="14sp"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnMfaDeny"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/mfa_approval_deny"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
