<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/emailDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/actionReply"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_reply"
                    android:padding="10dp"
                    android:src="@drawable/ic_reply" />

                <ImageButton
                    android:id="@+id/actionReplyAll"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_reply_all"
                    android:padding="10dp"
                    android:src="@drawable/ic_reply_all" />

                <ImageButton
                    android:id="@+id/actionForward"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_forward"
                    android:padding="10dp"
                    android:src="@drawable/ic_forward" />

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/actionArchive"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_archive"
                    android:padding="10dp"
                    android:src="@drawable/ic_archive" />

                <ImageButton
                    android:id="@+id/actionJunk"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_junk"
                    android:padding="10dp"
                    android:src="@drawable/ic_spam" />

                <ImageButton
                    android:id="@+id/actionDelete"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_delete"
                    android:padding="10dp"
                    android:src="@drawable/ic_delete" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/emailSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/emailFrom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="16dp" />

        <View
            android:id="@+id/emailDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#cccccc"
            android:layout_marginBottom="12dp" />

        <!--
            Anti-phishing warning, above the PGP bar because it is the more
            urgent thing to read: PGP describes how a message was protected,
            this says the message is trying to take over the device. A bare
            TextView rather than a LinearLayout — unlike the PGP and
            images-blocked bars there is no action button, because the
            dangerous links are already refused by SAFE_LINK_SCHEMES.
        -->
        <TextView
            android:id="@+id/emailPhishingBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textSize="13sp"
            android:text="@string/email_phishing_warning"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/emailPgpBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/emailPgpText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnOpenInWebmail"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:visibility="gone"
                android:text="@string/email_pgp_open_webmail_button" />

            <Button
                android:id="@+id/btnDecryptHere"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:visibility="gone"
                android:text="@string/email_pgp_decrypt_button" />

            <Button
                android:id="@+id/btnRetryPayload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:visibility="gone"
                android:text="@string/email_pgp_retry_button" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/emailImagesBlockedBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/emailImagesBlockedText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:text="@string/email_images_blocked_message" />

            <Button
                android:id="@+id/btnShowImages"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/email_show_images_button" />

        </LinearLayout>

        <ImageView
            android:id="@+id/emailLockedPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/email_pgp_locked_placeholder_description"
            android:scaleType="fitCenter"
            android:padding="48dp"
            android:src="@drawable/ic_lock_large"
            android:visibility="gone" />

        <WebView
            android:id="@+id/emailWebView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/emailAttachmentsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/email_attachments"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/emailAttachmentChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:chipSpacingHorizontal="6dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/emailBodyLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

</FrameLayout>
