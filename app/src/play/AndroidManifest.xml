<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Play uses the shared GMS sources but has its own manifest because TipActivity exists
             only in this flavor. Keep this service aligned with src/gms/AndroidManifest.xml. -->
        <service
            android:name=".push.KyPostFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".TipActivity"
            android:exported="false" />
    </application>
</manifest>
