# Signing material for release builds.
#
# PREFER THE ENVIRONMENT. app/build.gradle.kts reads these four environment variables first and
# only falls back to this file:
#
#   KYPOST_KEYSTORE         absolute path to the .jks
#   KYPOST_STORE_PASSWORD   store password
#   KYPOST_KEY_ALIAS        key alias
#   KYPOST_KEY_PASSWORD     key password
#
# Source them from a secret manager at release time, e.g.:
#
#   set -x KYPOST_STORE_PASSWORD (pass show kypost/release/store)
#   set -x KYPOST_KEY_PASSWORD   (pass show kypost/release/key)
#   ./gradlew :app:bundleRelease
#
# Passwords in this file sit in cleartext in the working tree. .gitignore stops one specific
# accident and nothing else: not a tarball, not an rsync, not a backup daemon, not `COPY .` in a
# Dockerfile, not any process running as your user.
storeFile=/path/to/KyPost-Prod.jks
storePassword=
keyAlias=kypost-prod
keyPassword=
